<!doctype html>
<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>コール練習</title>
<style>
:root{--bg:#faf8ff;--ink:#241b3a;--sub:#6e6685;--line:#e4def2;--acc:#6a3fd6;--call:#d6336c;--cur:#efe8ff;color-scheme:light}
@media (prefers-color-scheme:dark){:root{--bg:#15111f;--ink:#f0ecfa;--sub:#a79fbe;--line:#2f2745;--acc:#a98bff;--call:#ff7aa8;--cur:#2a2145;color-scheme:dark}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:16px/1.6 "Hiragino Sans","Noto Sans JP","Yu Gothic",system-ui,sans-serif}
.top{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line)}
.wrap{max-width:720px;margin:0 auto;padding:0 12px}
.video{aspect-ratio:16/9;background:#000;border-radius:0 0 10px 10px;overflow:hidden;display:grid;place-items:center;color:#aaa;font-size:14px}
.video iframe{width:100%;height:100%}
.count{display:flex;align-items:baseline;gap:12px;padding:8px 4px}
.count .num{font-size:44px;font-weight:700;font-variant-numeric:tabular-nums;line-height:1;min-width:3.6ch;color:var(--acc)}
.count .num small{font-size:16px;font-weight:500;margin-left:2px}
.count .lab{font-size:12px;color:var(--sub);line-height:1.3}
.count .nx{font-size:18px;font-weight:700;line-height:1.3}
.count.soon .num,.count.soon .nx{color:var(--call)}
.bar{display:flex;flex-wrap:wrap;gap:8px;padding:10px 0}
.bar input[type=text]{flex:1 1 200px;min-width:0}
input,button,select,textarea{font:inherit;color:inherit;background:transparent;border:1px solid var(--line);border-radius:8px;padding:7px 10px}
button{cursor:pointer;background:var(--cur)}
button:hover{border-color:var(--acc)}
:focus-visible{outline:2px solid var(--acc);outline-offset:2px}
.seek input{width:6.5em}
#lines{list-style:none;margin:0;padding:0 0 40vh}
#lines li button{display:grid;grid-template-columns:3.6em 1fr;gap:8px;width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);border-radius:0;background:transparent;padding:10px 4px}
#lines .t{color:var(--sub);font-size:13px;font-variant-numeric:tabular-nums;padding-top:3px}
#lines .c{display:block;color:var(--call);font-weight:700;font-size:18px}
#lines li.cur button{background:var(--cur)}
#lines li.cur .l{font-weight:700}
details{margin:0 0 24px;color:var(--sub);font-size:14px}
textarea{width:100%;height:220px;font:14px/1.5 ui-monospace,Menlo,monospace}
.empty{padding:28px 4px;color:var(--sub)}
</style>
</head>
<body>
<div class="top">
  <div class="wrap">
    <div class="video"><div id="player">YouTubeのURLを入れて「読み込む」</div></div>
    <div class="count" id="count">
      <div class="num" id="num">--<small>秒</small></div>
      <div><div class="lab">次のコールまで</div><div class="nx" id="nx">-</div></div>
    </div>
  </div>
</div>

<main class="wrap">
  <div class="bar">
    <input type="text" id="url" placeholder="YouTubeのURL" aria-label="YouTubeのURL">
    <button id="load">読み込む</button>
  </div>
  <div class="bar seek">
    <input type="text" id="sec" placeholder="1:23 or 83" aria-label="ジャンプ先の秒数" inputmode="decimal">
    <button id="go">ジャンプ</button>
    <button data-d="-5">-5秒</button>
    <button data-d="5">+5秒</button>
    <select id="rate" aria-label="再生速度">
      <option value="0.5">0.5x</option><option value="0.75">0.75x</option>
      <option value="1" selected>1x</option><option value="1.25">1.25x</option>
    </select>
  </div>

  <ul id="lines"></ul>

  <details>
    <summary>歌詞・コールを編集する</summary>
    <p>1行に「秒数|歌詞|コール」。コールがない行は最後を空に。「#」で始まる行はメモです。</p>
    <textarea id="data" spellcheck="false" aria-label="歌詞データ"></textarea>
    <div class="bar"><button id="apply">反映する</button><button id="reset">初期データに戻す</button></div>
  </details>
</main>

<script>
// ★初期データ。ここを自分で書き換えてGitHubに置けばOK（歌詞は自分で入力してね）
var DEFAULT_DATA = [
  "# 秒数|歌詞|コール",
  "0:10|（ここに歌詞を入力）|",
  "0:15|（ここに歌詞を入力）|（ここにコール）",
  "0:20|（ここに歌詞を入力）|",
  "0:25|（ここに歌詞を入力）|（ここにコール）"
].join("\n");

var $ = function(s){return document.querySelector(s)};
var player = null, data = [], items = [], lastCur = -2, pendingId = null;

function store(k, v){ try{ if(v===undefined) return localStorage.getItem(k); localStorage.setItem(k, v); }catch(e){ return null; } }
function parseTime(s){
  s = String(s).trim();
  if(s.indexOf(":") > -1) return s.split(":").map(Number).reduce(function(a,b){return a*60+b},0);
  return parseFloat(s);
}
function fmt(t){ var m = Math.floor(t/60), s = Math.floor(t%60); return m + ":" + (s<10?"0":"") + s; }
function parseData(txt){
  return txt.split("\n").map(function(l){return l.trim()}).filter(function(l){return l && l[0] !== "#"})
    .map(function(l){ var p = l.split("|"); return {t:parseTime(p[0]), lyric:(p[1]||"").trim(), call:(p[2]||"").trim()}; })
    .filter(function(x){return !isNaN(x.t)}).sort(function(a,b){return a.t-b.t});
}
function render(){
  var ul = $("#lines"); ul.innerHTML = ""; items = [];
  if(!data.length){ ul.innerHTML = '<li class="empty">歌詞データがありません。下の「編集する」から追加してください。</li>'; return; }
  data.forEach(function(d, i){
    var li = document.createElement("li"), b = document.createElement("button");
    b.innerHTML = '<span class="t"></span><span><span class="l"></span><span class="c"></span></span>';
    b.querySelector(".t").textContent = fmt(d.t);
    b.querySelector(".l").textContent = d.lyric;
    b.querySelector(".c").textContent = d.call;
    b.onclick = function(){ seek(d.t); };
    li.appendChild(b); ul.appendChild(li); items.push(li);
  });
  lastCur = -2;
}
function loadData(txt){ data = parseData(txt); render(); }

function videoId(s){
  var m = s.match(/(?:v=|youtu\.be\/|embed\/|shorts\/|live\/)([\w-]{11})/);
  if(m) return m[1];
  return /^[\w-]{11}$/.test(s.trim()) ? s.trim() : null;
}
function loadVideo(id){
  if(!id){ alert("YouTubeのURLを確認してください"); return; }
  store("call-video", id);
  if(player && player.loadVideoById){ player.loadVideoById(id); return; }
  pendingId = id;
  if(window.YT && YT.Player) makePlayer();
}
function makePlayer(){
  $(".video").innerHTML = '<div id="player"></div>';
  player = new YT.Player("player", {videoId: pendingId, playerVars:{playsinline:1, rel:0}});
}
window.onYouTubeIframeAPIReady = function(){ if(pendingId) makePlayer(); };

function ok(){ return player && player.getCurrentTime; }
function seek(t){ if(ok()){ player.seekTo(Math.max(0,t), true); player.playVideo(); } }

function tick(){
  if(!ok()) return;
  var cur = player.getCurrentTime(), rate = player.getPlaybackRate ? player.getPlaybackRate() : 1;
  var ci = -1, nx = null, i;
  for(i = 0; i < data.length; i++){ if(data[i].t <= cur) ci = i; }
  for(i = 0; i < data.length; i++){ if(data[i].call && data[i].t > cur){ nx = data[i]; break; } }
  if(ci !== lastCur){
    items.forEach(function(li, j){ li.classList.toggle("cur", j === ci); });
    if(items[ci]) items[ci].scrollIntoView({block:"center", behavior: matchMedia("(prefers-reduced-motion:reduce)").matches ? "auto" : "smooth"});
    lastCur = ci;
  }
  var box = $("#count");
  if(nx){
    var left = (nx.t - cur) / rate;
    $("#num").innerHTML = left.toFixed(1) + "<small>秒</small>";
    $("#nx").textContent = nx.call;
    box.classList.toggle("soon", left <= 3);
  } else {
    $("#num").innerHTML = "--<small>秒</small>"; $("#nx").textContent = "（この先のコールなし）"; box.classList.remove("soon");
  }
}
setInterval(tick, 100);

$("#load").onclick = function(){ loadVideo(videoId($("#url").value)); };
$("#url").onkeydown = function(e){ if(e.key === "Enter") $("#load").click(); };
$("#go").onclick = function(){ var t = parseTime($("#sec").value); if(!isNaN(t)) seek(t); };
$("#sec").onkeydown = function(e){ if(e.key === "Enter") $("#go").click(); };
document.querySelectorAll("[data-d]").forEach(function(b){
  b.onclick = function(){ if(ok()) seek(player.getCurrentTime() + Number(b.dataset.d)); };
});
$("#rate").onchange = function(){ if(ok()) player.setPlaybackRate(Number($("#rate").value)); };
$("#apply").onclick = function(){ store("call-data", $("#data").value); loadData($("#data").value); };
$("#reset").onclick = function(){ $("#data").value = DEFAULT_DATA; store("call-data", DEFAULT_DATA); loadData(DEFAULT_DATA); };

// 起動時：?v=動画ID があればそれを使う（曲ごとにリンクを作れる）
var saved = store("call-data") || DEFAULT_DATA;
$("#data").value = saved; loadData(saved);
var qv = new URLSearchParams(location.search).get("v") || store("call-video") || "eHPF_qGgq9Y";
if(qv){ $("#url").value = qv; loadVideo(videoId(qv)); }

var s = document.createElement("script"); s.src = "https://www.youtube.com/iframe_api"; document.head.appendChild(s);
</script>
</body>
</html>
